# AI drafts and resident questions. Configure backend/.env and restart the backend.
# AI stays unavailable until enabled and configured. Manual forms remain available.
COMMUNITY_AI_ENABLED=false
COMMUNITY_AI_BASE_URL=https://api.example.com/v1
COMMUNITY_AI_MODEL=replace-with-your-provider-model-name
COMMUNITY_AI_API_KEY=replace-with-your-provider-key
COMMUNITY_AI_TIMEOUT_SECONDS=30
COMMUNITY_AI_API_MODE=responses
COMMUNITY_AI_MODE=model
COMMUNITY_AI_PROVIDER_NAME=Local API
COMMUNITY_AI_REASONING_EFFORT=low

# API_MODE: responses appends /responses; chat_completions appends /chat/completions.
# Both modes require JSON-object responses. Responses requests use store=false.
# Cloud connections require HTTPS and a key. Never commit backend/.env.
# An optional local compatible server may use http://localhost:1234/v1,
# http://127.0.0.1:1234/v1, or http://[::1]:1234/v1 with an empty API key.
# URLs must not contain embedded credentials, query parameters, or fragments.
# Drafts send submitted form text. Resident questions also send role-filtered context
# and the recent dialogue, never app JWTs, provider credentials, or other residents' data.
# Outputs must be strict JSON; Markdown code fences and tool calls are rejected.
# Limits: 8 drafting attempts per user per minute per backend process.
